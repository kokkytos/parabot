# ── Required ──────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Airtable personal access token and base ID
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Public HTTPS base URL where Telegram delivers webhook updates.
# In Cloud Run this is the service URL, e.g.:
#   https://parabot-abc123-ew.a.run.app
# For local testing with a tunnel (e.g. ngrok):
#   https://abc123.ngrok.io
WEBHOOK_URL=

# ── Optional but strongly recommended ─────────────────────────────────────────

# Secret token Telegram includes in every webhook request
# (X-Telegram-Bot-Api-Secret-Token header). Any random string works.
WEBHOOK_SECRET=

# Secret token the GitHub Actions daily workflow sends in the
# X-Trigger-Token header when POSTing /trigger_daily_weather.
# Any random string works — generate one with: openssl rand -hex 32
DAILY_TRIGGER_TOKEN=

# ── Live Map (Telegram Mini App) ───────────────────────────────────────────────

# Public HTTPS URL served to Telegram as the Web App when a user taps /map.
# Typically the same as WEBHOOK_URL (the bot's Cloud Run / ngrok URL), since
# the aiohttp server now serves the map page at GET /.
# Example: https://parabot-abc123-ew.a.run.app
MINI_APP_URL=

# ── Weather APIs ───────────────────────────────────────────────────────────────

# OpenWeather API key (for /weather_para)
OPENWEATHER_API_KEY=

# Weather Underground API key (for /weather_gri, /weather_sev, /weather_all)
WU_API_KEY=

# Weather Underground station IDs (these are the defaults; only set if different)
# WU_STATION_ID=IGRIKA1
# WU_SEVASTO_STATION_ID=ISEVAS24

# ── Local dev only ─────────────────────────────────────────────────────────────

# Port the aiohttp server listens on (Cloud Run injects this automatically)
# PORT=8080
